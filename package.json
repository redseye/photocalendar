{
  "name": "photocalendar",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/ui": "~58.0.23",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.19",
    "expo-asset": "~58.0.18",
    "expo-build-properties": "~58.0.11",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-image-manipulator": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-widgets": "~58.0.23",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-android-widget": "^0.24.0",
    "react-native-safe-area-context": "~5.10.1"
  },
  "devDependencies": {
    "@expo-google-fonts/noto-serif-tc": "^0.4.5",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "harfbuzzjs": "^1.6.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "gen-photos": "node scripts/gen-photos.js",
    "gen-font": "node scripts/gen-font.js",
    "check-font": "node scripts/gen-font.js --check",
    "lint": "expo lint App.tsx index.ts src"
  },
  "expo": {
    "autolinking": {
      "android": {
        "exclude": [
          "expo-widgets",
          "@expo/ui",
          "expo-image-manipulator",
          "expo-image-loader"
        ]
      }
    }
  },
  "private": true
